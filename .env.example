# Runtime configuration
PORT=3000
HOST=0.0.0.0
# Set this to the exact production website origin; do not use * in production.
CORS_ORIGIN=https://your-production-domain.example
DATA_FILE=./data/db.json
MAX_BODY_BYTES=1048576
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# Generate a password hash with backend/src/auth.js before enabling admin login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_TTL_MS=28800000
