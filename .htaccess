# SSHP production routing
RewriteEngine On

# Keep the dedicated School–Teacher recruitment API out of the main API rewrite.
# Also preserve sub-routes such as /api/career.php/health, /api/career.php/vacancies, etc.
RewriteRule ^api/career\.php(?:/.*)?$ api/career.php [L,QSA]

# Route service requests to the dedicated idempotent endpoint.
# This prevents duplicate service-request rows and duplicate admin notifications.
RewriteRule ^api/service-requests$ api/service-requests.php [L,QSA]

# Route service orders to the dedicated idempotent order endpoint.
# This prevents duplicate database rows and duplicate admin notifications.
RewriteRule ^api/orders$ api/orders.php [L,QSA]

# Universal owner-email endpoint for normal public customer submissions.
RewriteRule ^api/owner-email-public$ api/owner-email-public.php [L,QSA]

RewriteCond %{REQUEST_URI} !^/api/index\.php$
RewriteRule ^api(?:/.*)?$ api/index.php [L,QSA]

# Load SSHP recruitment UI, official contact email, Google Tag Manager,
# Google AdSense, and connect the existing Careers navigation without editing the large HTML files.
<IfModule mod_substitute.c>
  AddOutputFilterByType SUBSTITUTE text/html

  # Inject the site-wide Google AdSense verification script into every HTML page's <head>.
  Substitute "s|</head>|<script async src=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8837115524897921\" crossorigin=\"anonymous\"></script></head>|i"

  # Load the site-wide GTM loader, recruitment UI, contact email helper, duplicate-submission guard,
  # final service/order submission fix, and universal normal-customer owner email sender.
  # Version query strings force browsers to load the corrected files.
  Substitute "s|</body>|<script src=\"/gtm.js?v=20260907-1\" defer></script><script src=\"/career.js?v=20260907-2\" defer></script><script src=\"/career-nav.js?v=20260907-2\" defer></script><script src=\"/teacher-jobs.js?v=20260907-2\" defer></script><script src=\"/contact-email.js?v=20260907-1\" defer></script><script src=\"/order-guard.js?v=20260908-3\" defer></script><script src=\"/order-submit-fix.js?v=20260908-2\" defer></script><script src=\"/universal-owner-email.js?v=20260909-1\" defer></script></body>|i"
</IfModule>
